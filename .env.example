# film-bench reads the OpenRouter key from here. bin/gen is the only thing that
# opens this file, and it refuses a key file that any other user can read.
#
#   cp .env.example .env && chmod 600 .env
#
# $FILMBENCH_ENV points at a key file somewhere else instead. The bench prints
# which file it resolved at startup, so there is no guessing about which key is
# being spent.
OPENROUTER_API_KEY=sk-or-v1-...
